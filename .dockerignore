# Send only the inputs needed for the production build.
**
!package.json
!bun.lock
!index.html
!tsconfig.json
!tsconfig.node.json
!vite.config.ts
!src/
!src/**
!docker/
!docker/**
!backend/
!backend/**

# Keep local configuration and generated content out of the build context.
**/.env
**/.env.*
**/*.local
**/node_modules
**/graphify-out

# Backend runtime secrets and local output must never enter an image.
backend/config.yaml
backend/auths
backend/logs
backend/static
backend/.git
backend/.github
backend/docs
backend/assets
backend/examples
backend/test
